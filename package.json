{
  "name": "fanjinde-seasons",
  "displayName": "Seasons",
  "description": "Four light-and-winter color themes inspired by spring, summer, autumn, and winter.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": ["Themes"],
  "contributes": {
    "themes": [
      {
        "label": "Seasons: Spring",
        "uiTheme": "vs",
        "path": "./themes/spring-color-theme.json"
      },
      {
        "label": "Seasons: Summer",
        "uiTheme": "vs",
        "path": "./themes/summer-color-theme.json"
      },
      {
        "label": "Seasons: Autumn",
        "uiTheme": "vs",
        "path": "./themes/autumn-color-theme.json"
      },
      {
        "label": "Seasons: Winter",
        "uiTheme": "vs-dark",
        "path": "./themes/winter-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fanjinde/seasons.git"
  },
  "keywords": [
    "vscode",
    "theme",
    "seasons"
  ],
  "publisher": "fanjinde"
}
